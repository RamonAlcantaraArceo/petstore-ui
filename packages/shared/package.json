{
  "name": "@petstore-ui/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared cross-package exports and testing utilities",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "pnpm --dir ../.. exec vitest run packages/shared",
    "lint": "pnpm --dir ../.. exec eslint packages/shared --ext .ts,.tsx",
    "format": "pnpm --dir ../.. exec prettier --write packages/shared",
    "format:check": "pnpm --dir ../.. exec prettier --check packages/shared",
    "type-check": "tsc --noEmit -p ../../tsconfig.json"
  }
}
